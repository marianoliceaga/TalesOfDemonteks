{
  "name": "tales-of-demonteks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tales of Demonteks - MVP (Phaser 3 + Vite + TypeScript)",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "npm run sync-assets",
    "dev": "vite",
    "prebuild": "npm run sync-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
